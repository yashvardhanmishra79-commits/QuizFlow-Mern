PORT=4400
MONGO_URL=mongodb://localhost:27017/quizflow
CORS_ORIGINS=http://localhost:5173

# Optional; required only for administrator AI quiz generation.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Optional request limits. Counts are per 15-minute login window and per
# 1-hour AI-generation window; login and AI requests are limited per client IP,
# and AI requests also have a per-admin-user limit.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_IP_MAX=10
AI_RATE_LIMIT_USER_MAX=5